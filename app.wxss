page {
  background: #fffaf4;
  color: #2f2925;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view,
scroll-view,
swiper,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  font-size: inherit;
  line-height: inherit;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 168rpx;
  box-sizing: border-box;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.page-subtitle {
  margin-top: 12rpx;
  color: #8e8178;
  font-size: 26rpx;
}

.section {
  margin-top: 48rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
}

.section-action {
  color: #e76f51;
  font-size: 24rpx;
}

.surface {
  background: #fffdf9;
  border: 1rpx solid #f1e5d8;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 30rpx rgba(75, 52, 40, 0.05);
}

.primary-button {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #e76f51;
  border-radius: 14rpx;
  font-weight: 700;
}

.secondary-button {
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e76f51;
  background: #fff1eb;
  border-radius: 12rpx;
  font-weight: 600;
}

.ghost-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  padding: 0 22rpx;
  color: #e76f51;
  background: #fff8f3;
  border: 1rpx solid #f5cbbd;
  border-radius: 10rpx;
}

.muted {
  color: #9e9188;
}

.empty-state {
  padding: 84rpx 30rpx;
  text-align: center;
  color: #9e9188;
}

.divider {
  height: 1rpx;
  margin: 28rpx 0;
  background: #f1e5d8;
}

.form-label {
  display: block;
  margin: 28rpx 0 14rpx;
  font-weight: 700;
}

.form-input,
.form-textarea,
.select-input {
  width: 100%;
  padding: 22rpx 24rpx;
  background: #fffdf9;
  border: 1rpx solid #eaded1;
  border-radius: 12rpx;
}

.form-textarea {
  min-height: 190rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
