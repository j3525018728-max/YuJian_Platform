page {
  --bg: #f6f7f4;
  --surface: #ffffff;
  --ink: #202522;
  --text-secondary: #56615a;
  --muted: #6e7971;
  --line: #e3e8e2;
  --brand: #ff6240;
  --brand-deep: #b63b22;
  --brand-soft: #fff0eb;
  --lime: #dff36a;
  --lime-soft: #f0f5d8;
  --mint-soft: #e7f3ed;
  --green: #32664d;
  --field: #eef1ed;
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  letter-spacing: 0;
}
view, scroll-view, swiper, button, input, textarea, image { box-sizing: border-box; }
button { margin: 0; padding: 0; border: 0; background: transparent; color: inherit; font-size: inherit; line-height: inherit; }
button::after { border: 0; }
button[disabled] { opacity: .5; }
.page { min-height: 100vh; padding: 32rpx 32rpx calc(148rpx + env(safe-area-inset-bottom)); }
.page-title { font-size: 44rpx; font-weight: 700; }
.page-subtitle { margin-top: 12rpx; color: var(--muted); font-size: 26rpx; }
.section { margin-top: 36rpx; }
.section-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 22rpx; }
.section-title { font-size: 32rpx; font-weight: 700; }
.section-action { color: var(--brand-deep); font-size: 24rpx; flex-shrink: 0; }
.surface { background: var(--surface); border: 1rpx solid var(--line); border-radius: 12rpx; }
.primary-button, .secondary-button { min-height: 88rpx; padding: 16rpx 24rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; border-radius: 12rpx; font-weight: 600; }
.primary-button { color: var(--surface); background: var(--ink); }
.secondary-button { color: var(--ink); background: var(--lime); }
.ghost-button { display: inline-flex; align-items: center; justify-content: center; min-height: 76rpx; padding: 0 22rpx; color: var(--brand-deep); background: var(--surface); border: 1rpx solid var(--line); border-radius: 10rpx; }
.muted { color: var(--muted); font-size: 23rpx; }
.empty-state { padding: 64rpx 24rpx; text-align: center; color: var(--muted); line-height: 1.7; }
.divider { height: 1rpx; margin: 28rpx 0; background: var(--line); }
.form-label { display: block; margin: 28rpx 0 14rpx; font-weight: 600; font-size: 25rpx; }
.form-input, .form-textarea, .select-input { width: 100%; min-height: 88rpx; padding: 22rpx 24rpx; background: var(--surface); border: 1rpx solid var(--line); border-radius: 12rpx; color: var(--ink); font-size: 26rpx; }
.form-textarea { min-height: 190rpx; }
.tag-list { display: flex; flex-wrap: wrap; gap: 14rpx; }
.icon { width: 36rpx; height: 36rpx; flex-shrink: 0; }
.icon-small { width: 28rpx; height: 28rpx; flex-shrink: 0; }
